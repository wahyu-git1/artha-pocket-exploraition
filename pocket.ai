        "\/v1\/savings-goals\/simulate": {
            "post": {
                "operationId": "savingsGoal.simulate",
                "tags": [
                    "SavingsGoal"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application\/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "price": {
                                        "type": "integer",
                                        "minimum": 1
                                    },
                                    "target_date": {
                                        "type": "string",
                                        "format": "date"
                                    },
                                    "saved_amount": {
                                        "type": [
                                            "integer",
                                            "null"
                                        ],
                                        "minimum": 0
                                    }
                                },
                                "required": [
                                    "price",
                                    "target_date"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "price": {
                                                    "type": "string"
                                                },
                                                "saved_amount": {
                                                    "anyOf": [
                                                        {
                                                            "type": "string"
                                                        },
                                                        {
                                                            "type": "integer",
                                                            "enum": [
                                                                0
                                                            ]
                                                        }
                                                    ]
                                                },
                                                "target_date": {
                                                    "type": "string"
                                                },
                                                "months_left": {
                                                    "type": "integer"
                                                },
                                                "monthly_amount": {
                                                    "type": "integer"
                                                },
                                                "is_realistic": {
                                                    "type": "boolean"
                                                },
                                                "total_income_balance": {
                                                    "type": "integer",
                                                    "description": "Pendapatan tidak tetap rata-rata 3 bulan (simplified for now, ideally we query avg receipts)\nFor simplicity, we just use the current balance of all incomes."
                                                },
                                                "warning": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ],
                                                    "enum": [
                                                        "Target tabungan bulanan melebihi total sisa pendapatan Anda.",
                                                        null
                                                    ]
                                                },
                                                "alternative_dates": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "string"
                                                    }
                                                }
                                            },
                                            "required": [
                                                "price",
                                                "saved_amount",
                                                "target_date",
                                                "months_left",
                                                "monthly_amount",
                                                "is_realistic",
                                                "total_income_balance",
                                                "warning",
                                                "alternative_dates"
                                            ]
                                        },
                                        "meta": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "data",
                                        "meta"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#\/components\/responses\/ValidationException"
                    },
                    "401": {
                        "$ref": "#\/components\/responses\/AuthenticationException"
                    }
                }
            }
        },
