{
    "openapi": "3.1.0",
    "info": {
        "title": "CatatDuit API Docs",
        "version": "1.0.0",
        "description": "CatatDuit API Documentation \u2014 Smart Personal Financial Tracking API (Laravel + PostgreSQL + Redis)"
    },
    "servers": [
        {
            "url": "http:\/\/127.0.0.1:8000\/api"
        }
    ],
    "security": [
        {
            "http": []
        }
    ],
    "paths": {
        "\/v1\/allocations\/templates": {
            "get": {
                "operationId": "allocation.templates",
                "tags": [
                    "Allocation"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "prefixItems": [
                                                {
                                                    "type": "object",
                                                    "properties": {
                                                        "code": {
                                                            "type": "string",
                                                            "const": "50-30-20"
                                                        },
                                                        "name": {
                                                            "type": "string",
                                                            "const": "Standar (50\/30\/20)"
                                                        },
                                                        "description": {
                                                            "type": "string",
                                                            "const": "50% Kebutuhan, 30% Keinginan, 20% Tabungan\/Investasi"
                                                        },
                                                        "items": {
                                                            "type": "array",
                                                            "prefixItems": [
                                                                {
                                                                    "type": "object",
                                                                    "properties": {
                                                                        "bucket": {
                                                                            "type": "string",
                                                                            "const": "need"
                                                                        },
                                                                        "percent": {
                                                                            "type": "integer",
                                                                            "const": 50
                                                                        }
                                                                    },
                                                                    "required": [
                                                                        "bucket",
                                                                        "percent"
                                                                    ]
                                                                },
                                                                {
                                                                    "type": "object",
                                                                    "properties": {
                                                                        "bucket": {
                                                                            "type": "string",
                                                                            "const": "want"
                                                                        },
                                                                        "percent": {
                                                                            "type": "integer",
                                                                            "const": 30
                                                                        }
                                                                    },
                                                                    "required": [
                                                                        "bucket",
                                                                        "percent"
                                                                    ]
                                                                },
                                                                {
                                                                    "type": "object",
                                                                    "properties": {
                                                                        "bucket": {
                                                                            "type": "string",
                                                                            "const": "saving"
                                                                        },
                                                                        "percent": {
                                                                            "type": "integer",
                                                                            "const": 10
                                                                        }
                                                                    },
                                                                    "required": [
                                                                        "bucket",
                                                                        "percent"
                                                                    ]
                                                                },
                                                                {
                                                                    "type": "object",
                                                                    "properties": {
                                                                        "bucket": {
                                                                            "type": "string",
                                                                            "const": "investment"
                                                                        },
                                                                        "percent": {
                                                                            "type": "integer",
                                                                            "const": 10
                                                                        }
                                                                    },
                                                                    "required": [
                                                                        "bucket",
                                                                        "percent"
                                                                    ]
                                                                }
                                                            ],
                                                            "minItems": 4,
                                                            "maxItems": 4
                                                        }
                                                    },
                                                    "required": [
                                                        "code",
                                                        "name",
                                                        "description",
                                                        "items"
                                                    ]
                                                },
                                                {
                                                    "type": "object",
                                                    "properties": {
                                                        "code": {
                                                            "type": "string",
                                                            "const": "60-20-20"
                                                        },
                                                        "name": {
                                                            "type": "string",
                                                            "const": "Agresif (60\/20\/20)"
                                                        },
                                                        "description": {
                                                            "type": "string",
                                                            "const": "Fokus ke tabungan & bayar utang"
                                                        },
                                                        "items": {
                                                            "type": "array",
                                                            "prefixItems": [
                                                                {
                                                                    "type": "object",
                                                                    "properties": {
                                                                        "bucket": {
                                                                            "type": "string",
                                                                            "const": "need"
                                                                        },
                                                                        "percent": {
                                                                            "type": "integer",
                                                                            "const": 60
                                                                        }
                                                                    },
                                                                    "required": [
                                                                        "bucket",
                                                                        "percent"
                                                                    ]
                                                                },
                                                                {
                                                                    "type": "object",
                                                                    "properties": {
                                                                        "bucket": {
                                                                            "type": "string",
                                                                            "const": "want"
                                                                        },
                                                                        "percent": {
                                                                            "type": "integer",
                                                                            "const": 20
                                                                        }
                                                                    },
                                                                    "required": [
                                                                        "bucket",
                                                                        "percent"
                                                                    ]
                                                                },
                                                                {
                                                                    "type": "object",
                                                                    "properties": {
                                                                        "bucket": {
                                                                            "type": "string",
                                                                            "const": "saving"
                                                                        },
                                                                        "percent": {
                                                                            "type": "integer",
                                                                            "const": 20
                                                                        }
                                                                    },
                                                                    "required": [
                                                                        "bucket",
                                                                        "percent"
                                                                    ]
                                                                }
                                                            ],
                                                            "minItems": 3,
                                                            "maxItems": 3
                                                        }
                                                    },
                                                    "required": [
                                                        "code",
                                                        "name",
                                                        "description",
                                                        "items"
                                                    ]
                                                }
                                            ],
                                            "minItems": 2,
                                            "maxItems": 2
                                        },
                                        "meta": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "data",
                                        "meta"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#\/components\/responses\/AuthenticationException"
                    }
                }
            }
        },
        "\/v1\/allocations\/recommendation": {
            "get": {
                "operationId": "allocation.recommendation",
                "tags": [
                    "Allocation"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "object",
                                            "description": "Let's assume standard if no history",
                                            "properties": {
                                                "template": {
                                                    "type": "string",
                                                    "const": "50-30-20"
                                                },
                                                "items": {
                                                    "type": "array",
                                                    "prefixItems": [
                                                        {
                                                            "type": "object",
                                                            "properties": {
                                                                "bucket": {
                                                                    "type": "string",
                                                                    "const": "need"
                                                                },
                                                                "percent": {
                                                                    "type": "integer",
                                                                    "const": 50
                                                                }
                                                            },
                                                            "required": [
                                                                "bucket",
                                                                "percent"
                                                            ]
                                                        },
                                                        {
                                                            "type": "object",
                                                            "properties": {
                                                                "bucket": {
                                                                    "type": "string",
                                                                    "const": "want"
                                                                },
                                                                "percent": {
                                                                    "type": "integer",
                                                                    "const": 30
                                                                }
                                                            },
                                                            "required": [
                                                                "bucket",
                                                                "percent"
                                                            ]
                                                        },
                                                        {
                                                            "type": "object",
                                                            "properties": {
                                                                "bucket": {
                                                                    "type": "string",
                                                                    "const": "saving"
                                                                },
                                                                "percent": {
                                                                    "type": "integer",
                                                                    "const": 10
                                                                }
                                                            },
                                                            "required": [
                                                                "bucket",
                                                                "percent"
                                                            ]
                                                        },
                                                        {
                                                            "type": "object",
                                                            "properties": {
                                                                "bucket": {
                                                                    "type": "string",
                                                                    "const": "investment"
                                                                },
                                                                "percent": {
                                                                    "type": "integer",
                                                                    "const": 10
                                                                }
                                                            },
                                                            "required": [
                                                                "bucket",
                                                                "percent"
                                                            ]
                                                        }
                                                    ],
                                                    "minItems": 4,
                                                    "maxItems": 4
                                                },
                                                "reasoning": {
                                                    "type": "string",
                                                    "const": "Berdasarkan standar alokasi ideal 50-30-20."
                                                }
                                            },
                                            "required": [
                                                "template",
                                                "items",
                                                "reasoning"
                                            ]
                                        },
                                        "meta": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "data",
                                        "meta"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#\/components\/responses\/AuthenticationException"
                    }
                }
            }
        },
        "\/v1\/allocations\/summary": {
            "get": {
                "operationId": "allocation.summary",
                "tags": [
                    "Allocation"
                ],
                "parameters": [
                    {
                        "name": "month",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "plan": {
                                                    "anyOf": [
                                                        {
                                                            "type": "array",
                                                            "items": {
                                                                "$ref": "#\/components\/schemas\/AllocationItem"
                                                            }
                                                        },
                                                        {
                                                            "type": "array",
                                                            "items": {
                                                                "type": "string"
                                                            },
                                                            "minItems": 0,
                                                            "maxItems": 0
                                                        }
                                                    ]
                                                },
                                                "realized": {
                                                    "type": "object",
                                                    "properties": {
                                                        "need": {
                                                            "type": "integer"
                                                        },
                                                        "want": {
                                                            "type": "integer"
                                                        },
                                                        "saving": {
                                                            "type": "integer"
                                                        },
                                                        "investment": {
                                                            "type": "integer"
                                                        },
                                                        "unmapped": {
                                                            "type": "integer"
                                                        }
                                                    },
                                                    "required": [
                                                        "need",
                                                        "want",
                                                        "saving",
                                                        "investment",
                                                        "unmapped"
                                                    ]
                                                }
                                            },
                                            "required": [
                                                "plan",
                                                "realized"
                                            ]
                                        },
                                        "meta": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "data",
                                        "meta"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#\/components\/responses\/AuthenticationException"
                    }
                }
            }
        },
        "\/v1\/allocations\/category-mapping": {
            "put": {
                "operationId": "allocation.updateCategoryMapping",
                "tags": [
                    "Allocation"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application\/json": {
                            "schema": {
                                "$ref": "#\/components\/schemas\/AllocationCategoryMappingRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#\/components\/schemas\/CategoryBucketMapping"
                                            }
                                        },
                                        "meta": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "data",
                                        "meta"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#\/components\/responses\/AuthenticationException"
                    },
                    "422": {
                        "$ref": "#\/components\/responses\/ValidationException"
                    }
                }
            }
        },
        "\/v1\/allocations": {
            "get": {
                "operationId": "allocation.index",
                "tags": [
                    "Allocation"
                ],
                "parameters": [
                    {
                        "name": "month",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "anyOf": [
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": {
                                                    "$ref": "#\/components\/schemas\/AllocationPlanResource"
                                                },
                                                "meta": {
                                                    "type": "string"
                                                }
                                            },
                                            "required": [
                                                "data",
                                                "meta"
                                            ]
                                        },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": {
                                                    "type": "null"
                                                },
                                                "meta": {
                                                    "type": "string"
                                                }
                                            },
                                            "required": [
                                                "data",
                                                "meta"
                                            ]
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#\/components\/responses\/AuthenticationException"
                    }
                }
            }
        },
        "\/v1\/auth\/register": {
            "post": {
                "operationId": "auth.register",
                "tags": [
                    "Auth"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application\/json": {
                            "schema": {
                                "$ref": "#\/components\/schemas\/RegisterRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "user": {
                                                    "$ref": "#\/components\/schemas\/UserResource"
                                                },
                                                "access_token": {
                                                    "type": "string"
                                                },
                                                "refresh_token": {
                                                    "type": "string"
                                                },
                                                "expires_in": {
                                                    "type": "integer",
                                                    "const": 900
                                                },
                                                "token_type": {
                                                    "type": "string",
                                                    "const": "Bearer"
                                                }
                                            },
                                            "required": [
                                                "user",
                                                "access_token",
                                                "refresh_token",
                                                "expires_in",
                                                "token_type"
                                            ]
                                        },
                                        "meta": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "data",
                                        "meta"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#\/components\/responses\/ValidationException"
                    }
                },
                "security": []
            }
        },
        "\/v1\/auth\/login": {
            "post": {
                "operationId": "auth.login",
                "tags": [
                    "Auth"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application\/json": {
                            "schema": {
                                "$ref": "#\/components\/schemas\/LoginRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "user": {
                                                    "$ref": "#\/components\/schemas\/UserResource"
                                                },
                                                "access_token": {
                                                    "type": "string"
                                                },
                                                "refresh_token": {
                                                    "type": "string"
                                                },
                                                "expires_in": {
                                                    "type": "integer",
                                                    "const": 900
                                                },
                                                "token_type": {
                                                    "type": "string",
                                                    "const": "Bearer"
                                                }
                                            },
                                            "required": [
                                                "user",
                                                "access_token",
                                                "refresh_token",
                                                "expires_in",
                                                "token_type"
                                            ]
                                        },
                                        "meta": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "data",
                                        "meta"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "object",
                                            "properties": {
                                                "code": {
                                                    "type": "string",
                                                    "const": "INVALID_CREDENTIALS"
                                                },
                                                "message": {
                                                    "type": "string",
                                                    "const": "Email atau kata sandi tidak valid."
                                                },
                                                "details": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "string"
                                                    },
                                                    "minItems": 0,
                                                    "maxItems": 0
                                                }
                                            },
                                            "required": [
                                                "code",
                                                "message",
                                                "details"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "error"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#\/components\/responses\/ValidationException"
                    }
                },
                "security": []
            }
        },
        "\/v1\/auth\/refresh": {
            "post": {
                "operationId": "auth.refresh",
                "tags": [
                    "Auth"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application\/json": {
                            "schema": {
                                "$ref": "#\/components\/schemas\/RefreshTokenRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "401": {
                        "description": "",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "object",
                                            "properties": {
                                                "code": {
                                                    "type": "string",
                                                    "enum": [
                                                        "TOKEN_EXPIRED",
                                                        "TOKEN_INVALID"
                                                    ]
                                                },
                                                "message": {
                                                    "type": "string",
                                                    "enum": [
                                                        "Refresh token sudah kedaluwarsa.",
                                                        "Refresh token tidak valid atau telah dicabut."
                                                    ]
                                                },
                                                "details": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "string"
                                                    },
                                                    "minItems": 0,
                                                    "maxItems": 0
                                                }
                                            },
                                            "required": [
                                                "code",
                                                "message",
                                                "details"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "error"
                                    ]
                                }
                            }
                        }
                    },
                    "200": {
                        "description": "",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "access_token": {
                                                    "type": "string"
                                                },
                                                "refresh_token": {
                                                    "type": "string"
                                                },
                                                "expires_in": {
                                                    "type": "integer",
                                                    "const": 900
                                                },
                                                "token_type": {
                                                    "type": "string",
                                                    "const": "Bearer"
                                                }
                                            },
                                            "required": [
                                                "access_token",
                                                "refresh_token",
                                                "expires_in",
                                                "token_type"
                                            ]
                                        },
                                        "meta": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "data",
                                        "meta"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#\/components\/responses\/ValidationException"
                    }
                },
                "security": []
            }
        },
        "\/v1\/auth\/logout": {
            "post": {
                "operationId": "auth.logout",
                "tags": [
                    "Auth"
                ],
                "responses": {
                    "204": {
                        "description": "No content"
                    },
                    "401": {
                        "$ref": "#\/components\/responses\/AuthenticationException"
                    }
                }
            }
        },
        "\/v1\/categories": {
            "get": {
                "operationId": "categories.index",
                "tags": [
                    "Category"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#\/components\/schemas\/CategoryResource"
                                            }
                                        },
                                        "meta": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "data",
                                        "meta"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#\/components\/responses\/AuthenticationException"
                    }
                }
            },
            "post": {
                "operationId": "categories.store",
                "tags": [
                    "Category"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application\/json": {
                            "schema": {
                                "$ref": "#\/components\/schemas\/CategoryRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#\/components\/schemas\/CategoryResource"
                                        },
                                        "meta": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "data",
                                        "meta"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#\/components\/responses\/AuthenticationException"
                    },
                    "422": {
                        "$ref": "#\/components\/responses\/ValidationException"
                    }
                }
            }
        },
        "\/v1\/categories\/{category}": {
            "get": {
                "operationId": "categories.show",
                "tags": [
                    "Category"
                ],
                "parameters": [
                    {
                        "name": "category",
                        "in": "path",
                        "required": true,
                        "description": "The category ID",
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#\/components\/schemas\/CategoryResource"
                                        },
                                        "meta": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "data",
                                        "meta"
                                    ]
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "object",
                                            "properties": {
                                                "code": {
                                                    "type": "string",
                                                    "const": "FORBIDDEN"
                                                },
